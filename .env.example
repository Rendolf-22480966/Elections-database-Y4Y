# Copy this file to `.env.local` (never commit `.env.local`).
# Get these values from Supabase: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Server-only. Needed only if you later add server-side user invites.
# Never prefix this with NEXT_PUBLIC_ and never put it in client code.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
